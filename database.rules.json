{
  "rules": {
    "directorio": {
      "$correoKey": {
        ".read": true,
        ".write": "auth.token.email === 'vaeronspa@gmail.com' || !data.exists()"
      }
    },
    "cuentas": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'vaeronspa@gmail.com')",
        ".write": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && newData.child('rol').val() !== 'superadmin' && ((newData.exists() && newData.child('tiendaId').val() === root.child('cuentas').child(auth.uid).child('tiendaId').val()) || (!newData.exists() && data.child('tiendaId').val() === root.child('cuentas').child(auth.uid).child('tiendaId').val()))))"
      }
    },
    "eventos": {
      ".read": "auth != null && auth.token.email === 'vaeronspa@gmail.com'",
      ".write": "auth != null && auth.token.email === 'vaeronspa@gmail.com'"
    },
    "tiendas": {
      ".read": "auth != null && auth.token.email === 'vaeronspa@gmail.com'",
      ".write": "auth != null && auth.token.email === 'vaeronspa@gmail.com'",
      "$tiendaId": {
        ".read": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId)",
        "info": {
          ".write": "auth != null && auth.token.email === 'vaeronspa@gmail.com'"
        },
        "usuarios": {
          "$uid": {
            ".write": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId && auth.uid !== $uid))"
          }
        },
        "products": {
          ".indexOn": "updatedAt",
          ".write": "auth != null && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId && (newData.exists() || root.child('cuentas').child(auth.uid).child('rol').val() === 'admin')"
        },
        "clients": {
          ".indexOn": "updatedAt",
          ".write": "auth != null && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId && (newData.exists() || root.child('cuentas').child(auth.uid).child('rol').val() === 'admin')"
        },
        "orders": {
          "$orderId": {
            ".write": "auth != null && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId && (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' || !data.exists() || data.child('vendedorUid').val() === auth.uid) && (!newData.exists() || (newData.child('total').val() >= 0 && newData.child('subtotal').val() >= 0 && newData.child('total').val() <= newData.child('subtotal').val() + 0.01))"
          }
        },
        "config": {
          ".write": "auth != null && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId && data.child('logoUrl').val() === newData.child('logoUrl').val() && data.child('almacenesNombres').child('alm1').val() === newData.child('almacenesNombres').child('alm1').val() && data.child('almacenesNombres').child('alm2').val() === newData.child('almacenesNombres').child('alm2').val() && data.child('almacenesNombres').child('alm3').val() === newData.child('almacenesNombres').child('alm3').val() && data.child('almacenesNombres').child('alm4').val() === newData.child('almacenesNombres').child('alm4').val() && data.child('almacenesNombres').child('alm5').val() === newData.child('almacenesNombres').child('alm5').val() && data.child('almacenesNombres').child('alm6').val() === newData.child('almacenesNombres').child('alm6').val() && data.child('almacenesActivos').child('alm1').val() === newData.child('almacenesActivos').child('alm1').val() && data.child('almacenesActivos').child('alm2').val() === newData.child('almacenesActivos').child('alm2').val() && data.child('almacenesActivos').child('alm3').val() === newData.child('almacenesActivos').child('alm3').val() && data.child('almacenesActivos').child('alm4').val() === newData.child('almacenesActivos').child('alm4').val() && data.child('almacenesActivos').child('alm5').val() === newData.child('almacenesActivos').child('alm5').val() && data.child('almacenesActivos').child('alm6').val() === newData.child('almacenesActivos').child('alm6').val() && data.child('permisosVendedor').child('verDashboard').val() === newData.child('permisosVendedor').child('verDashboard').val() && data.child('permisosVendedor').child('verForo').val() === newData.child('permisosVendedor').child('verForo').val() && data.child('permisosVendedor').child('editarStock').val() === newData.child('permisosVendedor').child('editarStock').val()",
          "logoUrl": {
            ".write": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId))"
          },
          "almacenesNombres": {
            ".write": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId))"
          },
          "almacenesActivos": {
            ".write": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId && (newData.child('alm3').val() !== true || root.child('tiendas').child($tiendaId).child('info').child('plan').val() !== 'basico') && (newData.child('alm4').val() !== true || root.child('tiendas').child($tiendaId).child('info').child('plan').val() === 'medio' || root.child('tiendas').child($tiendaId).child('info').child('plan').val() === 'premium') && (newData.child('alm5').val() !== true || root.child('tiendas').child($tiendaId).child('info').child('plan').val() === 'premium') && (newData.child('alm6').val() !== true || root.child('tiendas').child($tiendaId).child('info').child('plan').val() === 'premium')))"
          },
          "permisosVendedor": {
            ".write": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId))"
          }
        },
        "catalogoPublico": {
          ".read": "data.child('activo').val() === true",
          ".write": "auth != null && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId && data.child('activo').val() === newData.child('activo').val() && data.child('nombreTienda').val() === newData.child('nombreTienda').val() && data.child('whatsapp').val() === newData.child('whatsapp').val()",
          "activo": {
            ".write": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId))"
          },
          "nombreTienda": {
            ".write": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId))"
          },
          "whatsapp": {
            ".write": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId))"
          },
          "productos": {
            "$code": {
              ".write": "auth != null && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId && (newData.exists() || root.child('cuentas').child(auth.uid).child('rol').val() === 'admin')"
            }
          }
        }
      }
    },
    "foro": {
      "publicaciones": {
        ".read": true,
        "$postId": {
          ".write": "auth != null && root.child('cuentas').child(auth.uid).child('tiendaId').val() != null && (!data.exists() || data.child('tiendaId').val() === root.child('cuentas').child(auth.uid).child('tiendaId').val()) && (!newData.exists() || newData.child('tiendaId').val() === root.child('cuentas').child(auth.uid).child('tiendaId').val())"
        }
      }
    },
    "vendorSecrets": {
      "$tiendaId": {
        "$uid": {
          ".read": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId))",
          ".write": "auth != null && (auth.token.email === 'vaeronspa@gmail.com' || (root.child('cuentas').child(auth.uid).child('rol').val() === 'admin' && root.child('cuentas').child(auth.uid).child('tiendaId').val() === $tiendaId))"
        }
      }
    }
  }
}
